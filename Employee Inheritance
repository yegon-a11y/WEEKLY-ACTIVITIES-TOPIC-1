class Employee:
    def __init__(self, emp_name, emp_id):
        self.emp_name = emp_name
        self.emp_id = emp_id

    def displayEmployee(self):
        return f"Employee Details:" {self.emp_name}, {self.emp_id}


class Lecturer(Employee):
    def __init__(self, emp_name, emp_id, subject):
