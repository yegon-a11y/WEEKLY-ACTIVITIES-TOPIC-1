class Product:
    def __init__(self):
        self.name = ""
        self.code = ""
        self.price = 0.0
        self.quantity = 0

    def setProductDetails(self, name, code, price, quantity):
        self.name = name
        self.code = code
        self.price = price
        self.quantity = quantity

    def calculateStockValue(self):
        return self.price * self.quantity

    def displayProductDetails(self):
        print("\n--- Product Details ---")
        print(f"Product Name : {self.name}")
        print(f"Product Code : {self.code}")
        print(f"Price        : KSh {self.price:,.2f}")
        print(f"Quantity     : {self.quantity}")
        print(f"Stock Value  : KSh {self.calculateStockValue():,.2f}")


if __name__ == "__main__":
    product = Product()
    product.setProductDetails("Wireless Mouse", "P001", 1500, 20)

    stock_value = product.calculateStockValue()
    print(f"Calculated stock value: KSh {stock_value:,.2f}")

    product.displayProductDetails()
