class Student:
    def __init__(self):
        self.name = ""
        self.reg_number = ""
        self.course = ""
        self.mark = 0

    def setStudentDetails(self, name, reg_number, course, mark):
        self.name = name
        self.reg_number = reg_number
        self.course = course
        self.mark = mark

    def calculateGrade(self):
        if self.mark >= 70:
            return "A"
        elif self.mark >= 60:
            return "B"
        elif self.mark >= 50:
            return "C"
        elif self.mark >= 40:
            return "D"
        else:
            return "F"

    def displayStudentDetails(self):
        print("\n--- Student Details ---")
        print(f"Name                : {self.name}")
        print(f"Registration Number : {self.reg_number}")
        print(f"Course              : {self.course}")
        print(f"Mark                : {self.mark}")
        print(f"Grade               : {self.calculateGrade()}")


if __name__ == "__main__":
    student = Student()
    student.setStudentDetails("Josh", "BSCIT-01-0058/2025", "BSc Information Technology", 78)

    grade = student.calculateGrade()
    print(f"Calculated grade: {grade}")

    student.displayStudentDetails()
